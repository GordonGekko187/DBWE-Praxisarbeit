# Vorlage fuer .env (wird nicht versioniert). Werte vor dem Start ersetzen.
# DATABASE_URL zeigt auf eine lokal installierte PostgreSQL-Instanz
# (siehe README, Abschnitt Inbetriebnahme).
SECRET_KEY=bitte-durch-zufallswert-ersetzen
DATABASE_URL=postgresql+psycopg2://apex:bitte-ersetzen@localhost:5432/apex
